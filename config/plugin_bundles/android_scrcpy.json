{
  "id": "mobile-scrcpy",
  "name": "scrcpy 高帧率投屏",
  "version": "2.4",
  "description": "Android 真机/模拟器高帧率画布投屏（H.264 WebSocket）。与 adb 配套使用，安装后自动写入 SCRCPY_PATH；未安装时平台仍可用内置 scrcpy-server 降级。",
  "license": "Apache License 2.0",
  "license_url": "https://github.com/Genymobile/scrcpy/blob/master/LICENSE",
  "platforms": {
    "windows": {
      "filename": "scrcpy-win64.zip",
      "url": "https://github.com/Genymobile/scrcpy/releases/download/v2.4/scrcpy-win64-v2.4.zip",
      "mirror_urls": [],
      "sha256": "",
      "size_mb_hint": 6
    },
    "linux": {
      "filename": "scrcpy-linux.zip",
      "url": "https://github.com/Genymobile/scrcpy/releases/download/v2.4/scrcpy-linux-v2.4.tar.gz",
      "archive": "tar.gz",
      "size_mb_hint": 6
    },
    "darwin": {
      "filename": "scrcpy-macos.zip",
      "url": "https://github.com/Genymobile/scrcpy/releases/download/v2.4/scrcpy-macos-v2.4.tar.gz",
      "archive": "tar.gz",
      "size_mb_hint": 6
    }
  },
  "local_bundle_search": [
    "plugin_bundles/{filename}",
    "offline_plugins/{filename}",
    "config/plugin_bundles/{filename}"
  ]
}
