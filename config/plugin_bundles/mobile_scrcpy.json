{
  "id": "mobile-scrcpy",
  "name": "scrcpy (mirror + control)",
  "version": "2.7",
  "type": "runtime_bundle",
  "description": "高帧率投屏 + PC 端反控（tap/swipe）。安装后自动写入 scrcpy_path。",
  "platforms": {
    "windows": {
      "filename": "scrcpy-win64-v2.7.zip",
      "zip_inner_dir": "scrcpy-win64-v2.7",
      "scrcpy_binary": "scrcpy.exe",
      "url": "https://github.com/Genymobile/scrcpy/releases/download/v2.7/scrcpy-win64-v2.7.zip",
      "sha256": "",
      "size_mb_hint": 40
    }
  },
  "local_bundle_search": [
    "plugin_bundles/{filename}",
    "config/plugin_bundles/{filename}",
    "static/plugin_bundles/{filename}"
  ]
