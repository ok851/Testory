{
  "id": "mobile-android-emulator-sdk",
  "name": "Android 模拟器 SDK（命令行）",
  "version": "1.0.0",
  "description": "无需 Android Studio：一键安装 Android 模拟器、系统镜像与默认虚拟手机（Testory_Pixel7），安装后可直接在「移动端测试」启动。首次约 2–4GB，需已安装 Java 11+，并需联网或由管理员提供离线安装包。",
  "license": "Android Software Development Kit License",
  "license_url": "https://developer.android.com/studio/terms",
  "default_avd": {
    "name": "Testory_Pixel7",
    "device_id": "pixel_7",
    "system_image": "system-images;android-34;google_apis;x86_64"
  },
  "sdk_repo_mirror": "https://mirrors.aliyun.com/android/repository/",
  "sdk_packages": [
    "platform-tools",
    "platforms;android-34",
    "system-images;android-34;google_apis;x86_64",
    "emulator",
    "extras;google;Android_Emulator_Hypervisor_Driver"
  ],
  "platforms": {
    "windows": {
      "filename": "commandlinetools-win-latest.zip",
      "url": "https://dl.google.com/android/repository/commandlinetools-win-11076708_latest.zip",
      "mirror_urls": [
        "https://mirrors.aliyun.com/android/repository/commandlinetools-win-11076708_latest.zip",
        "https://mirrors.cloud.tencent.com/AndroidSDK/commandlinetools-win-11076708_latest.zip"
      ],
      "sha256": "",
      "size_mb_hint": 150
    },
    "linux": {
      "filename": "commandlinetools-linux-latest.zip",
      "url": "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip",
      "mirror_urls": [
        "https://mirrors.aliyun.com/android/repository/commandlinetools-linux-11076708_latest.zip"
      ],
      "sha256": "",
      "size_mb_hint": 150
    },
    "darwin": {
      "filename": "commandlinetools-mac-latest.zip",
      "url": "https://dl.google.com/android/repository/commandlinetools-mac-11076708_latest.zip",
      "mirror_urls": [
        "https://mirrors.aliyun.com/android/repository/commandlinetools-mac-11076708_latest.zip"
      ],
      "sha256": "",
      "size_mb_hint": 150
    }
  },
  "local_bundle_search": [
    "plugin_bundles/{filename}",
    "config/plugin_bundles/{filename}",
    "static/plugin_bundles/{filename}"
  ]
}
