# Docker full-stack：Browser Runtime + Hermes（Hermes 通常由宿主机离线包自启）
EMBEDDED_BROWSER_GATEWAY_URL=http://embedded-browser-gateway:8765
EMBEDDED_BROWSER_GATEWAY_SECRET=change-embedded-browser-secret
EMBEDDED_BROWSER_PUBLIC_WS_BASE=ws://host.docker.internal:8765
HERMES_GATEWAY_URL=http://host.docker.internal:8642
HERMES_API_SERVER_KEY=change-hermes-api-key
AI_CHAT_TOOLS_ENABLE=1
