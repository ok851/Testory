# 复制为 .env 后配合 full-stack profile 使用:
#   docker compose --profile full-stack up -d
#
# 将下列 URL 指向 Compose 内网服务名（容器间 DNS）

EMBEDDED_BROWSER_GATEWAY_URL=http://embedded-browser-gateway:8765
EMBEDDED_BROWSER_GATEWAY_SECRET=change-embedded-browser-secret
EMBEDDED_BROWSER_PUBLIC_WS_BASE=ws://127.0.0.1:8765

OPENCLAW_GATEWAY_URL=http://openclaw-gateway:18789
OPENCLAW_GATEWAY_TOKEN=change-openclaw-gateway-token

AI_CHAT_TOOLS_ENABLE=1
