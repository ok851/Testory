  "status": "success",
  "goal": "验证订单 ORD-DEMO-404 在 API 为 failed，且下单页展示「下单失败」文案，两端一致。",
  "plan": {
    "plan_id": "goai-order-fail-demo",
    "scenario": "下单失败一致性（合成 Demo）",
    "schema_version": "1.0",
    "stages": [
      {
        "id": "stage-api-order",
        "layer": "api",
        "label": "ApiHttp：查询订单状态",
        "skill": "testory-api-test",
        "depends_on": [],
        "timeout_seconds": 30,
        "request": {
          "method": "GET",
          "url": "https://demo.testory.local/api/orders/ORD-DEMO-404"
        },
        "assert": {
          "status_in": [
            200
          ]
        },
        "vars_to_store": [
          {
            "name": "order_id",
            "from": "body.order_id"
          },
          {
            "name": "order_status",
            "from": "body.status"
          }
        ],
        "sync_point": "order_loaded"
      },
      {
        "id": "stage-web-order",
        "layer": "web",
        "label": "WebBrowse：核对下单失败文案",
        "skill": "testory-web-browser",
        "depends_on": [
          "stage-api-order"
        ],
        "timeout_seconds": 60,
        "actions": [
          {
            "type": "navigate",
            "url": "https://demo.testory.local/orders/ORD-DEMO-404"
          },
          {
            "type": "assert_text",
            "selector": ".order-status",
            "contains": "下单失败"
          }
        ],
        "vars_to_store": [
          {
            "name": "ui_status_text",
            "from": "selector:.order-status"
          }
        ],
        "sync_point": "ui_checked"
      }
    ],
    "cross_end_assertions": [
      {
        "name": "order_id_present",
        "left": {
          "var": "order_id"
        },
        "op": "eq",
        "right": {
          "value": "ORD-DEMO-404"
        }
      },
      {
        "name": "api_status_is_failed",
        "left": {
          "var": "order_status"
        },
        "op": "eq",
        "right": {
          "value": "failed"
        }
      },
      {
        "name": "ui_shows_fail_copy",
        "left": {
          "var": "ui_status_text"
        },
        "op": "contains",
        "right": {
          "value": "下单失败"
        }
      }
    ]
  },
  "vars": {
    "order_id": "ORD-DEMO-404",
    "order_status": "failed",
    "ui_status_text": "下单失败"
  },
