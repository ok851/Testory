# 产品官网 — 独立配置（复制为 .env）
# Monorepo 开发时：若不建本文件，会回退读取仓库根目录 .env

WEBSITE_PORT=5200
WEBSITE_URL=http://127.0.0.1:5200
WEBSITE_SECRET=

# 服务端访问控制面（生产用内网/管理域，勿写 127.0.0.1）
PLATFORM_ADMIN_URL=http://127.0.0.1:5100
PLATFORM_ADMIN_SECRET=change-me-long-random

WEBSITE_CONTACT_EMAIL=contact@example.com
WEBSITE_CONTACT_PHONE=
