# 创始人控制面 — 独立配置（复制为 .env）
# Monorepo 开发时：若不建本文件，会回退读取仓库根目录 .env

PLATFORM_ADMIN_PORT=5100
PLATFORM_ADMIN_USER=founder
PLATFORM_ADMIN_PASSWORD=change-me
PLATFORM_ADMIN_SECRET=change-me-long-random

# 供 releases 页展示、API 返回官网链接
WEBSITE_URL=http://127.0.0.1:5200

# Nginx 子路径部署（纯 IP 场景 http://IP/admin/）；本地开发留空
# PLATFORM_ADMIN_PATH_PREFIX=/admin

# HTTPS 生产环境建议开启 Secure Cookie
# PLATFORM_ADMIN_SECURE_COOKIES=1

# 数据目录（默认 projects/testory-platform-admin/data/）
# PLATFORM_ADMIN_DB=
