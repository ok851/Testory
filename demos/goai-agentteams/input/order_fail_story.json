{
  "story_id": "order-fail-consistency",
  "title": "下单失败：API 与 Web 状态一致",
  "description": "用户提交订单后业务侧显示失败。质检目标：用 API 查单状态，并用 Web 页核对失败文案，断言两端一致。注意：业务失败 ≠ 测试失败；测试应在一致性成立时通过。",
  "goal": "验证订单 ORD-DEMO-404 在 API 为 failed，且下单页展示「下单失败」文案，两端一致。",
  "plan": {
    "plan_id": "goai-order-fail-demo",
    "scenario": "下单失败一致性（合成 Demo）",
    "schema_version": "1.0",
    "stages": [
      {
        "id": "stage-api-order",
        "layer": "api",
        "label": "ApiHttp：查询订单状态",
        "skill": "testory-api-test",
        "depends_on": [],
        "timeout_seconds": 30,
        "request": {
          "method": "GET",
          "url": "https://demo.testory.local/api/orders/ORD-DEMO-404"
        },
        "assert": {
          "status_in": [200]
        },
        "vars_to_store": [
          {"name": "order_id", "from": "body.order_id"},
          {"name": "order_status", "from": "body.status"}
        ],
        "sync_point": "order_loaded"
      },
      {
        "id": "stage-web-order",
        "layer": "web",
        "label": "WebBrowse：核对下单失败文案",
        "skill": "testory-web-browser",
        "depends_on": ["stage-api-order"],
        "timeout_seconds": 60,
        "actions": [
          {"type": "navigate", "url": "https://demo.testory.local/orders/ORD-DEMO-404"},
          {"type": "assert_text", "selector": ".order-status", "contains": "下单失败"}
        ],
        "vars_to_store": [
          {"name": "ui_status_text", "from": "selector:.order-status"}
        ],
        "sync_point": "ui_checked"
      }
    ],
    "cross_end_assertions": [
      {
        "name": "order_id_present",
        "left": {"var": "order_id"},
        "op": "eq",
        "right": {"value": "ORD-DEMO-404"}
      },
      {
        "name": "api_status_is_failed",
        "left": {"var": "order_status"},
        "op": "eq",
        "right": {"value": "failed"}
      },
      {
        "name": "ui_shows_fail_copy",
        "left": {"var": "ui_status_text"},
        "op": "contains",
        "right": {"value": "下单失败"}
      }
    ]
  },
  "simulate": {
    "consistent": {
      "note": "API failed + UI「下单失败」→ 质检应通过",
      "expect_run_status": "success"
    },
    "mismatch": {
      "note": "API failed 但 UI 仍显示成功 → 质检应失败（诚实红灯）",
      "expect_run_status": "failed"
    }
  }
}
