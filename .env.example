# IMPORTANT: Every comment line must start with #. If you copy from docs without #, python-dotenv will fail to parse.
# Copy this file to `.env` in the same folder (`.env` is gitignored), then edit values.
# Or set variables in your shell / IDE run configuration instead.
# Missing keys from this file are auto-appended to `.env` on Flask startup (env_example_sync) and never overwrite existing lines.
# Manual one-shot: python env_example_sync.py
# To disable auto-append: set system env SKIP_ENV_EXAMPLE_SYNC=1 before starting Python (not in .env; it loads after sync).

# =============================================================================
# Docker Compose（默认仅 Web 平台容器）与本机 Windows 套件对照
# =============================================================================
# 默认: docker compose up -d uat-platform  （不启动 OpenClaw / embedded 网关）
# 可选: docker compose --profile full-stack up -d
#       并参考 docker-compose.full-stack.env.example 配置内网 URL
# 详见 docs/DOCKER_COMPOSE.md · 架构图 docs/assets/architecture_local_16x9.png
#
# 本机开发（混排 Web+桌面）: packaging/run_uat_local.ps1 或 DEPLOYMENT_PROFILE=local

# =============================================================================
# 本机 Python / 浏览器依赖（Windows 本地版首次部署；须与 python app.py 同一解释器）
# =============================================================================
# 在项目根目录依次执行（推荐一键：.\packaging\run_uat_local.ps1）：
#   pip install -r requirements.txt
#   pip install -r requirements-windows.txt
#   python -m playwright install chromium
# 说明：
#   - 元素捕获器 / 桌面步骤 / 桌面拾取 依赖 pywinauto（在 requirements-windows.txt，勿单独漏装）
#   - 同文件还含：pyperclip、pyautogui、mss、psutil、pywebview（桌面版窗口可选）
#   - Web 用例执行 / 网页拾取 依赖 Playwright 及 Chromium（第二条 pip + 第三条命令）
#   - 可选开发工具（XPath Codegen）：.\tools\install_playwright_xpath_codegen.ps1（需 Node.js 18+）
# 下列变量供安装核对与脚本读取；装妥后可把 *_INSTALLED 改为 1（应用不强制，仅备忘）
UAT_REQUIREMENTS_FILE=requirements.txt
UAT_REQUIREMENTS_WINDOWS_FILE=requirements-windows.txt
UAT_PLAYWRIGHT_INSTALL_BROWSER=chromium
UAT_WINDOWS_PIP_PACKAGES=pywinauto>=0.6.8,pyperclip>=1.8.2,pyautogui>=0.9.54,mss>=9.0.0,psutil>=5.9.0,pywebview>=5.0
UAT_PIP_INSTALL_CMD=pip install -r requirements.txt && pip install -r requirements-windows.txt
UAT_PLAYWRIGHT_INSTALL_CMD=python -m playwright install chromium
UAT_DEPS_BASE_INSTALLED=0
UAT_DEPS_WINDOWS_INSTALLED=0
UAT_PLAYWRIGHT_CHROMIUM_INSTALLED=0

# --- Path A: AI chat tool loop + OpenClaw Gateway (optional execution backend) ---
# Enables multi-turn tool calling on /api/ai/task/chat ("优化"), including openclaw_execute.
# AI_CHAT_TOOLS_ENABLE=1
#
# Docker 内默认：http://openclaw-gateway:18789（见 docker-compose.yml）
# 本机仅 Flask：例如 OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=replace-with-gateway-token
# OPENCLAW_GATEWAY_TIMEOUT=120
# 可选镜像标签：OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
# 首次容器化部署若需交互 onboarding，见 https://documentation.openclaw.ai/install/docker
# OPENCLAW_SKIP_ONBOARDING=1
#
# Optional:
# OPENCLAW_EXECUTE_MODE=chat_completions
# OPENCLAW_CHAT_COMPLETIONS_MODEL=openclaw/default
# OPENCLAW_TOOLS_INVOKE_PATH=/tools/invoke
# OPENCLAW_EXECUTE_TOOL_NAME=
# OPENCLAW_GATEWAY_SESSION_KEY=
# 整系统/多模块探索：提高网关超时（秒，客户端上限 1200）与工具轮数；长返回截断字符
# OPENCLAW_GATEWAY_TIMEOUT=600
# AI_CHAT_TOOLS_MAX_ROUNDS=24
# OPENCLAW_TOOL_RESULT_MAX_CHARS=96000
# 发给 OpenClaw /v1/chat/completions 的可选 system 提示（引导自主浏览、输出 URL/操作摘要/检查点结论）
# OPENCLAW_EXECUTE_SYSTEM_PROMPT=你是浏览器端测试代理；请按用户指令自主操作页面，并在回复中给出可复现为自动化步骤的摘要（含 URL、关键选择器或可见文案）。
# 若网关支持 max_tokens：OPENCLAW_CHAT_MAX_TOKENS=8192
#
# --- Embedded browser gateway（AI 测试：远程执行 + 可选画布 + CDP 调试）---
# 需单独启动进程（与 Flask 不同终端）：在项目根目录执行  python -m embedded_browser_gateway
# EMBEDDED_BROWSER_GATEWAY_URL=http://127.0.0.1:8765
# EMBEDDED_BROWSER_GATEWAY_SECRET=replace-with-same-secret-as-gateway
# 画布 / 输入同步用 WebSocket（旧「远程画布」）；CDP 直连调试为推荐方式，画布可选
# EMBEDDED_BROWSER_PUBLIC_WS_BASE=ws://127.0.0.1:8765
# 若客户端从其他机器连接 CDP：将调试 URL 中的主机改为可达 IP（端口与网关进程内分配一致）
# EMBEDDED_BROWSER_PUBLIC_CDP_HOST=
# 远程 inspect 返回的最大可交互控件条数（与主站快照一致），默认 200，上限 240
# EMBEDDED_INSPECT_MAX_ITEMS=200
# 每步成功后暂停毫秒，便于实时画面与 SPA 提交（0 关闭），默认 120
# EMBEDDED_STEP_SETTLE_MS=120
# 每步成功后向画布 WS 推送一帧 Playwright 截图（与 CDP 串流并行，对齐步进画面），默认 1；0 关闭以省 CPU
# EMBEDDED_SNAP_AFTER_STEP=1
#
# --- AI 规划前主会话抓取目标页（加快「开工」）---
# 仅 domcontentloaded、不等待 networkidle；超时毫秒默认 22000
# AI_PROBE_NAVIGATE_TIMEOUT_MS=22000
# 主会话脚本步骤 navigate 之后可选的 load 等待（毫秒），默认 12000；设为 0 则不再额外等 load
# AI_SCRIPT_POST_NAV_LOAD_TIMEOUT_MS=12000
# 生成/优化后按 LIVE 注册表启发式修复选择器（密码 name=pwd、登录 XPath→text 等），默认开启
# LOCAL_AI_HEURISTIC_SELECTOR_REPAIR=1
#
# --- AI 定位器解析（执行前根据页面快照补全选择器，与 AI_SELECTOR_FALLBACK 互补）---
# AI_LOCATOR_RESOLVE_ENABLE=1
# 离线验证：python -m element_locator_steward resolve --url https://example.com --plan plan.json
#
# --- 用例失败钩子（执行线程无 Flask 上下文；user_id/tenant_id 由路由传入 ExecutionContext）---
# 与 LOCAL_MEMORY_ENABLE 配合：失败时写入向量记忆 kind=case_failure（需已配置嵌入模型）。
# 设为 1 时，在存在 user_id 与 project_id 的前提下自动创建 defects 表记录（慎用，避免重复噪声）。
# AUTO_DEFECT_ON_CASE_FAILURE=0
#
# --- AI 失败诊断（步骤失败自动附带 failure_diag；/api/ai/diagnostics/failure-bundle）---
# AI_FAILURE_DIAG_ENABLE=1
# AI_STEP_FAILURE_DIAG=1
# AI_STEP_FAILURE_DIAG_RING=80
# AI_STEP_FAILURE_DIAG_EVENTS_TAIL=40
# AI_STEP_FAILURE_DIAG_LLM=0
# Chromium CDP Performance.getMetrics（可选）
# AI_DIAG_CDP_ENABLE=0
#
# --- 结构化场景（需求说明书 → 半结构化 scenarios JSON）---
# AI_SCENARIO_REQUIREMENTS_MAX_CHARS=24000
#
# --- 本机 Ollama（LOCAL_LLM_*）---
# 单次生成最大 token。不设时 HuFirst 对 /api/chat 默认传 num_predict=4096，避免 Modelfile 默认过小导致用例 JSON 半截。
# 更长用例可加大，例如 8192；-1 表示由 Ollama 不限制（仍受模型上下文上限约束）。
# LOCAL_LLM_NUM_PREDICT=8192
#
# --- 本地版部署（默认；单机 Web + 桌面混排，无远程测试机 Agent）---
# DEPLOYMENT_PROFILE=local
# DESKTOP_EXECUTION_MODE=inprocess
# PLAYWRIGHT_HEADLESS=0
# 一键启动见 packaging/run_uat_local.ps1
#
# --- Windows 桌面自动化（混排 Web + 桌面）---
# 本地版默认 inprocess，无需网关。以下均为可选：步骤编辑页可用「从当前打开的窗口选择」，
# launch_app 可填 notepad.exe 由系统自动解析路径，通常不必配置 DESKTOP_DEFAULT_LAUNCH_PATH。
# DESKTOP_AUTO_START_GATEWAY=0
# DESKTOP_AGENT_GATEWAY_URL=http://127.0.0.1:8766
# DESKTOP_AGENT_GATEWAY_SECRET=replace-with-local-secret
# DESKTOP_EXECUTION_MODE=gateway
# DESKTOP_DEFAULT_LAUNCH_PATH=          # launch_app 留空时使用（如 C:\Apps\client.exe）
# DESKTOP_DEFAULT_ATTACH_TITLE_RE=      # 仅当 DESKTOP_AUTO_ATTACH_DEFAULT=1 且 attach 未选窗口时生效
# DESKTOP_AUTO_ATTACH_DEFAULT=0         # 勿用全局记事本正则覆盖「选择当前窗口」；演示可设 1
# DESKTOP_LAUNCH_FALLBACK=              # 可选：launch 留空时的程序名（如 notepad.exe），一般不必设
# DESKTOP_OPERATION_TIMEOUT=120         # 桌面单步 Worker 超时（秒）
# DESKTOP_LAUNCH_TIMEOUT=120            # launch_app/attach_window 专用（秒，0=用 OPERATION_TIMEOUT）
# DESKTOP_DEEP_SEARCH=0                 # 1=在 Program Files 浅层扫描 exe（较慢，仅当常规方式找不到时）
# DESKTOP_START_MENU_CACHE_SEC=600      # 开始菜单 .lnk 索引缓存秒数
# DESKTOP_APP_ALIASES={"erp":"C:\\\\ERP\\\\client.exe"}  # 自定义别名，步骤填 erp 即可
# DESKTOP_APP_ALIASES=                  # 别名：步骤填 erp 或 @erp；填 default 才走 default 键
# DESKTOP_DEFAULT_BACKEND=uia
# 元素捕获：全屏红框提示（多 topmost 窗口，默认 0 关闭）；悬停预览 1 开启 / 0 关闭
# 桌面元素捕获器：策略内置在 desktop_picker.py（Win32 图标 + 限时 UIA），无需 DESKTOP_PICKER_* 开关
# DESKTOP_PHYSICAL_MOUSE=0              # 1=移动真实鼠标（默认 0：UIA/PostMessage 后台点击，不抢用户光标）
# DESKTOP_STEAL_FOCUS=0                 # 1=执行时 SetForegroundWindow（默认 0 不抢焦点）
# DESKTOP_COORDINATE_PHYSICAL=0         # 1=屏幕坐标步骤移动真实鼠标（默认 0：后台消息，不抢鼠标）
# DESKTOP_SHELL_PHYSICAL=1              # 1=桌面图标双击用真实鼠标（默认 1，Explorer 常需物理双击）
# DESKTOP_STEP_RETRY=1                  # 桌面指针步骤失败后的额外重试次数（默认 1）
# DESKTOP_FAILURE_SCREENSHOT=1          # 指针失败时保存虚拟桌面截图（默认 1）
# PLAYWRIGHT_CLICK_FORCE_DEFAULT=0      # 1=Web 点击默认 force（默认 0，须元素可见）
#
# --- 企业多机（可选，默认不启用）---
# DEPLOYMENT_PROFILE=enterprise
# DESKTOP_EXECUTION_MODE=remote
# 远程测试机 API /api/desktop/machines 仅在 enterprise 下可用
