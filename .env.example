# IMPORTANT: Every comment line must start with #. If you copy from docs without #, python-dotenv will fail to parse.
# Copy this file to `.env` in the same folder (`.env` is gitignored), then edit values.
# Or set variables in your shell / IDE run configuration instead.

# --- Path A: AI chat tool loop + OpenClaw Gateway (optional execution backend) ---
# Enables multi-turn tool calling on /api/ai/task/chat ("优化"), including openclaw_execute.
# AI_CHAT_TOOLS_ENABLE=1
#
# Required for OpenClaw execution tools (see openclaw_gateway_client.py):
# OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=replace-with-gateway-token
# OPENCLAW_GATEWAY_TIMEOUT=120
#
# Optional:
# OPENCLAW_EXECUTE_MODE=chat_completions
# OPENCLAW_CHAT_COMPLETIONS_MODEL=openclaw/default
# OPENCLAW_TOOLS_INVOKE_PATH=/tools/invoke
# OPENCLAW_EXECUTE_TOOL_NAME=
# OPENCLAW_GATEWAY_SESSION_KEY=
#
# --- Embedded browser gateway (AI 测试页「远程画布」、边看边跑) ---
# 需单独启动进程（与 Flask 不同终端）：在项目根目录执行  python -m embedded_browser_gateway
# EMBEDDED_BROWSER_GATEWAY_URL=http://127.0.0.1:8765
# EMBEDDED_BROWSER_GATEWAY_SECRET=replace-with-same-secret-as-gateway
# EMBEDDED_BROWSER_PUBLIC_WS_BASE=ws://127.0.0.1:8765
